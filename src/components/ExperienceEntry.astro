---
interface Props {
  position: string;
  organization: string;
  location: string;
  dateLabel: string;
  description?: string;
  highlights?: string[];
  link?: { url: string; label: string };
  showHighlights?: boolean;
  level?: 2 | 3;
}

const {
  position,
  organization,
  location,
  dateLabel,
  description,
  highlights = [],
  link,
  showHighlights = true,
  level = 3,
} = Astro.props;

const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="py-6">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <Heading class="text-base font-semibold text-zinc-900 dark:text-white">{position}</Heading>
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{dateLabel}</p>
  </div>
  <p class="mt-0.5 text-sm font-medium text-zinc-600 dark:text-zinc-300">
    {organization}
    {
      link && (
        <>
          {' '}
          ·{' '}
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="prose-link">
            {link.label}
          </a>
        </>
      )
    }
    <span class="text-zinc-400 dark:text-zinc-500"> — {location}</span>
  </p>

  {description && <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{description}</p>}

  {
    showHighlights && highlights.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {highlights.map((item) => (
          <li class="flex gap-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
