---
import Icon from './Icon.astro';

interface Props {
  name: string;
  description: string;
  contribution?: string;
  technologies?: string[];
  outcomes?: string[];
  github?: string;
  demo?: string;
  publication?: string;
  compact?: boolean;
  level?: 2 | 3;
}

const {
  name,
  description,
  contribution,
  technologies = [],
  outcomes = [],
  github,
  demo,
  publication,
  compact = false,
  level = 3,
} = Astro.props;

const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="rounded-lg border border-zinc-200 p-6 transition-colors hover:border-zinc-300 dark:border-zinc-800 dark:hover:border-zinc-700">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <Heading class="text-base font-semibold text-zinc-900 dark:text-white">{name}</Heading>
    <div class="flex items-center gap-3">
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} on GitHub`}
            class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            <Icon name="github" class="h-5 w-5" />
          </a>
        )
      }
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} live demo`}
            class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            <Icon name="external-link" class="h-5 w-5" />
          </a>
        )
      }
    </div>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{description}</p>

  {!compact && contribution && (
    <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{contribution}</p>
  )}

  {
    !compact && outcomes.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {outcomes.map((item) => (
          <li class="flex gap-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    !compact && publication && (
      <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
        Associated publication: <span class="text-zinc-700 dark:text-zinc-300">{publication}</span>
      </p>
    )
  }

  {
    technologies.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <li class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            {tech}
          </li>
        ))}
      </ul>
    )
  }
</article>
