---
interface Props {
  institution: string;
  logo?: string;
  degree?: string;
  location: string;
  dateLabel: string;
  details?: readonly string[];
  level?: 2 | 3;
}

const { institution, logo, degree, location, dateLabel, details = [], level = 3 } = Astro.props;

const Heading = level === 2 ? 'h2' : 'h3';
---

<div class="flex gap-4 py-6">
  {
    logo && (
      <img
        src={logo}
        alt=""
        class="h-12 w-12 shrink-0 rounded-md object-contain"
      />
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <Heading class="text-base font-semibold text-zinc-900 dark:text-white">{institution}</Heading>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">{dateLabel}</p>
    </div>
    {
      degree && (
        <p class="mt-0.5 text-sm font-medium text-zinc-600 dark:text-zinc-300">
          {degree}
          <span class="text-zinc-400 dark:text-zinc-500"> — {location}</span>
        </p>
      )
    }
    {
      !degree && (
        <p class="mt-0.5 text-sm font-medium text-zinc-600 dark:text-zinc-300">{location}</p>
      )
    }
    {
      details.length > 0 && (
        <ul class="mt-3 space-y-1.5">
          {details.map((item) => (
            <li class="flex gap-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
