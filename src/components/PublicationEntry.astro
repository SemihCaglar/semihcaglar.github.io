---
interface Props {
  title: string;
  authors: string[];
  highlightAuthor: string;
  venue: string;
  year: number;
  status?: string;
  doi?: string;
  arxiv?: string;
  pdf?: string;
  code?: string;
  projectUrl?: string;
  compact?: boolean;
  level?: 2 | 3;
}

const {
  title,
  authors,
  highlightAuthor,
  venue,
  year,
  status,
  doi,
  arxiv,
  pdf,
  code,
  projectUrl,
  compact = false,
  level = 3,
} = Astro.props;

const links = [
  doi && { label: 'DOI', url: doi },
  arxiv && { label: 'arXiv', url: arxiv },
  pdf && { label: 'PDF', url: pdf },
  code && { label: 'Code', url: code },
  projectUrl && { label: 'Project', url: projectUrl },
].filter(Boolean) as { label: string; url: string }[];

const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="py-6">
  <Heading class="text-base font-semibold leading-snug text-zinc-900 dark:text-white">{title}</Heading>

  <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
    {
      authors.map((author, index) => (
        <>
          {author === highlightAuthor ? (
            <strong class="font-semibold text-zinc-900 dark:text-white">{author}</strong>
          ) : (
            author
          )}
          {index < authors.length - 1 ? ', ' : ''}
        </>
      ))
    }
  </p>

  <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400">
    <span class="italic">{venue}</span>, {year}
    {status && <span class="ml-1 font-medium text-zinc-700 dark:text-zinc-300">· {status}</span>}
  </p>

  {
    !compact && links.length > 0 && (
      <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1">
        {links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="prose-link text-sm">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>
