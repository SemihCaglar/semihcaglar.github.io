---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { site, socialLinks } from '../data/site';

const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);

const description = `Peer-reviewed publications and competition results by ${site.name} in software engineering and machine learning.`;

const scholarLink = socialLinks.find((link) => link.icon === 'scholar');
---

<BaseLayout title={`Publications | ${site.name}`} description={description} path="/publications">
  <section class="mx-auto max-w-4xl px-6 py-14">
    <PageHeader title="Publications" description="Research papers and competition results I've co-authored." />

    {
      scholarLink && (
        <a
          href={scholarLink.url}
          target="_blank"
          rel="noopener noreferrer"
          class="prose-link -mt-6 mb-10 inline-block text-sm"
        >
          View full profile on Google Scholar →
        </a>
      )
    }

    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        publications.map((pub) => (
          <PublicationEntry
            title={pub.data.title}
            authors={pub.data.authors}
            highlightAuthor={pub.data.highlightAuthor}
            venue={pub.data.venue}
            year={pub.data.year}
            status={pub.data.status}
            abstract={pub.data.abstract}
            doi={pub.data.doi}
            arxiv={pub.data.arxiv}
            pdf={pub.data.pdf}
            code={pub.data.code}
            projectUrl={pub.data.projectUrl}
            level={2}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
