---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`Page Not Found | ${site.name}`}
  description="The page you're looking for doesn't exist."
  path="/404"
>
  <section class="mx-auto flex max-w-4xl flex-col items-start px-6 py-24">
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl dark:text-white">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-base text-zinc-600 dark:text-zinc-300">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a href="/" class="prose-link mt-6 text-sm">← Back to home</a>
  </section>
</BaseLayout>
