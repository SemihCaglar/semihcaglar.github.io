---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import { site } from '../data/site';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const description = `Professional and research experience of ${site.name}, including roles in software engineering research, robotics, and machine learning.`;
---

<BaseLayout title={`Experience | ${site.name}`} description={description} path="/experience">
  <section class="mx-auto max-w-4xl px-6 py-14">
    <PageHeader title="Experience" description="A chronological look at my professional and research roles." />

    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        experience.map((entry) => (
          <ExperienceEntry
            position={entry.data.position}
            organization={entry.data.organization}
            location={entry.data.location}
            dateLabel={entry.data.dateLabel}
            description={entry.data.description}
            highlights={entry.data.highlights}
            link={entry.data.link}
            organizationUrl={entry.data.organizationUrl}
            descriptionLinks={entry.data.descriptionLinks}
            level={2}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
