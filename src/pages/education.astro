---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EducationEntry from '../components/EducationEntry.astro';
import { site, educationEntries } from '../data/site';

const description = `Academic background of ${site.name}, including university and prior schooling.`;
---

<BaseLayout title={`Education | ${site.name}`} description={description} path="/education">
  <section class="mx-auto max-w-4xl px-6 py-14">
    <PageHeader title="Education" description="My academic background." />

    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        educationEntries.map((entry) => (
          <EducationEntry
            institution={entry.institution}
            logo={entry.logo}
            degree={entry.degree}
            location={entry.location}
            dateLabel={entry.dateLabel}
            details={entry.details}
            level={2}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
